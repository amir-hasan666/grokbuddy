# Integration template. Local/CI uses explicit Settings and leaves real GitHub disabled.
HUB_MODE=local
HUB_BIND=127.0.0.1
DATABASE_URL=sqlite:///var/hub.db
PUBLIC_BASE=https://grokbuddy.amirhasan.top
REVIEWER_ADAPTER=mock
GROK_ENABLED=false
GROK_WAKEUP_PRIMARY=disabled
GROK_WAKEUP_FALLBACK=disabled
GITHUB_MODE=disabled
GITHUB_REPOSITORY=
GITHUB_BUILDER_ACTOR_ID=
GITHUB_REVIEWER_ACTOR_ID=
HUMAN_APPROVER_IDS=
GITHUB_BUILDER_TOKEN=
GITHUB_REVIEWER_TOKEN=
GITHUB_COMMENT_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
GROKBUDDY_GROK_REVIEWER_TOKEN=
HUB_CLIENT_TOKEN=
MAX_PLAN_REVIEW_ROUNDS=2
MAX_FINAL_REVIEW_ROUNDS=3
MAX_FINDINGS_PER_REVIEW=100
PLAN_REVIEW_TIMEOUT=900
FINAL_REVIEW_TIMEOUT=1800
MAX_TASK_DURATION=86400
GITHUB_POLL_INTERVAL=30
DELIVERY_MAX_ATTEMPTS=5
ARTIFACT_ROOT=var/artifacts
MAX_ARTIFACT_BYTES=52428800
ARTIFACT_RETENTION_DAYS=180
REVIEW_PROFILE=generic
