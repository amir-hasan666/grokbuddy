{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collab:request:v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "enum": ["v1", "v2"]
    },
    "task_id": {
      "$ref": "urn:collab:common:v1#/$defs/TASK"
    },
    "review_request_id": {
      "$ref": "urn:collab:common:v1#/$defs/RR"
    },
    "review_id": {
      "$ref": "urn:collab:common:v1#/$defs/REV"
    },
    "review_type": {
      "enum": [
        "PLAN_REVIEW",
        "FINAL_REVIEW"
      ]
    },
    "review_round": {
      "type": "integer",
      "minimum": 1
    },
    "content_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_task_version": {
      "type": "integer",
      "minimum": 0
    },
    "decision_policy_version": {
      "const": "grokbuddy-v1-dual-round"
    },
    "review_profile": {
      "$ref": "urn:collab:common:v1#/$defs/profile"
    },
    "review_profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "profile_sha256": {
      "$ref": "urn:collab:common:v1#/$defs/hash"
    },
    "input_sha256": {
      "$ref": "urn:collab:common:v1#/$defs/hash"
    },
    "profile_artifact_id": {
      "$ref": "urn:collab:common:v1#/$defs/ART"
    },
    "input_artifact_id": {
      "$ref": "urn:collab:common:v1#/$defs/ART"
    },
    "expected_reviewer_actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "deadline_at": {
      "$ref": "urn:collab:common:v1#/$defs/timestamp"
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "review_request_id",
    "review_id",
    "review_type",
    "review_round",
    "content_revision",
    "review_profile",
    "review_profile_version",
    "profile_sha256",
    "input_sha256",
    "profile_artifact_id",
    "input_artifact_id",
    "expected_reviewer_actor_id",
    "deadline_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"protocol_version": {"const": "v2"}},
        "required": ["protocol_version"]
      },
      "then": {"required": ["expected_task_version"]}
    }
  ]
}
