{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:collab:result:v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "v1"
        },
        "task_id": {
          "$ref": "urn:collab:common:v1#/$defs/TASK"
        },
        "review_request_id": {
          "$ref": "urn:collab:common:v1#/$defs/RR"
        },
        "review_id": {
          "$ref": "urn:collab:common:v1#/$defs/REV"
        },
        "review_type": {
          "const": "PLAN_REVIEW"
        },
        "review_round": {
          "type": "integer",
          "minimum": 1
        },
        "content_revision": {
          "type": "integer",
          "minimum": 1
        },
        "review_profile": {
          "$ref": "urn:collab:common:v1#/$defs/profile"
        },
        "review_profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "profile_sha256": {
          "$ref": "urn:collab:common:v1#/$defs/hash"
        },
        "input_sha256": {
          "$ref": "urn:collab:common:v1#/$defs/hash"
        },
        "verdict": {
          "enum": [
            "PASS",
            "NEEDS_CHANGES",
            "BLOCK"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "mock",
                "grok_bot",
                "gpt",
                "claude",
                "gemini",
                "local"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "timestamp": {
          "$ref": "urn:collab:common:v1#/$defs/timestamp"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "description",
              "blocking"
            ],
            "additionalProperties": false
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "review_request_id",
        "review_id",
        "review_type",
        "review_round",
        "content_revision",
        "review_profile",
        "review_profile_version",
        "profile_sha256",
        "input_sha256",
        "verdict",
        "summary",
        "reviewer",
        "timestamp",
        "comments",
        "risks",
        "suggestions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "v1"
        },
        "task_id": {
          "$ref": "urn:collab:common:v1#/$defs/TASK"
        },
        "review_request_id": {
          "$ref": "urn:collab:common:v1#/$defs/RR"
        },
        "review_id": {
          "$ref": "urn:collab:common:v1#/$defs/REV"
        },
        "review_type": {
          "const": "FINAL_REVIEW"
        },
        "review_round": {
          "type": "integer",
          "minimum": 1
        },
        "content_revision": {
          "type": "integer",
          "minimum": 1
        },
        "review_profile": {
          "$ref": "urn:collab:common:v1#/$defs/profile"
        },
        "review_profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "profile_sha256": {
          "$ref": "urn:collab:common:v1#/$defs/hash"
        },
        "input_sha256": {
          "$ref": "urn:collab:common:v1#/$defs/hash"
        },
        "verdict": {
          "enum": [
            "PASS",
            "NEEDS_CHANGES",
            "BLOCK"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewer": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "mock",
                "grok_bot",
                "gpt",
                "claude",
                "gemini",
                "local"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "timestamp": {
          "$ref": "urn:collab:common:v1#/$defs/timestamp"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "external_finding_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "severity": {
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              },
              "blocking": {
                "type": "boolean"
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "finding": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "evidence": {
                "$ref": "urn:collab:common:v1#/$defs/evidence"
              },
              "impact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "recommendation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "supersedes": {
                "$ref": "urn:collab:common:v1#/$defs/FND"
              },
              "parent_finding_id": {
                "$ref": "urn:collab:common:v1#/$defs/FND"
              }
            },
            "required": [
              "external_finding_key",
              "severity",
              "blocking",
              "category",
              "title",
              "finding",
              "evidence",
              "impact",
              "recommendation"
            ],
            "additionalProperties": false
          }
        },
        "verifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_id": {
                "$ref": "urn:collab:common:v1#/$defs/FND"
              },
              "outcome": {
                "enum": [
                  "VERIFIED",
                  "REOPENED"
                ]
              },
              "evidence": {
                "$ref": "urn:collab:common:v1#/$defs/evidence"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "finding_id",
              "outcome",
              "evidence",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocol_version",
        "task_id",
        "review_request_id",
        "review_id",
        "review_type",
        "review_round",
        "content_revision",
        "review_profile",
        "review_profile_version",
        "profile_sha256",
        "input_sha256",
        "verdict",
        "summary",
        "reviewer",
        "timestamp",
        "findings",
        "verifications"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "#/$defs/v2Result"
    },
    {
      "$ref": "#/$defs/legacyV2Result"
    }
  ],
  "$defs": {
    "v2Result": {
      "allOf": [{"$ref": "#/$defs/v2ResultBody"}],
      "required": ["decision_policy_version"]
    },
    "legacyV2Result": {
      "allOf": [{"$ref": "#/$defs/v2ResultBody"}],
      "not": {"required": ["decision_policy_version"]}
    },
    "v2Scope": {
      "type": "object",
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "files": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 300},
          "uniqueItems": true
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "v2Finding": {
      "type": "object",
      "properties": {
        "finding_id": {"$ref": "urn:collab:common:v1#/$defs/FND"},
        "external_finding_key": {"type": "string", "minLength": 1, "maxLength": 200},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "blocking": {"type": "boolean"},
        "category": {"type": "string", "minLength": 1, "maxLength": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence": {"$ref": "urn:collab:common:v1#/$defs/evidence"},
        "impact": {"type": "string", "minLength": 1, "maxLength": 4000},
        "recommendation": {"type": "string", "minLength": 1, "maxLength": 4000},
        "proposed_changes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "scope": {"$ref": "#/$defs/v2Scope"},
        "status": {"const": "OPEN"},
        "actionable": {"const": true},
        "supersedes": {"$ref": "urn:collab:common:v1#/$defs/FND"},
        "parent_finding_id": {"$ref": "urn:collab:common:v1#/$defs/FND"}
      },
      "required": [
        "external_finding_key", "severity", "blocking", "category", "title",
        "description", "evidence", "impact", "recommendation", "proposed_changes",
        "scope", "status", "actionable"
      ],
      "additionalProperties": false
    },
    "v2Verification": {
      "type": "object",
      "properties": {
        "finding_id": {"$ref": "urn:collab:common:v1#/$defs/FND"},
        "outcome": {"enum": ["VERIFIED", "REOPENED", "ADVISORY"]},
        "evidence": {"$ref": "urn:collab:common:v1#/$defs/evidence"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000}
      },
      "required": ["finding_id", "outcome", "evidence", "reason"],
      "additionalProperties": false
    },
    "v2ResultBody": {
      "type": "object",
      "properties": {
        "protocol_version": {"const": "v2"},
        "task_id": {"$ref": "urn:collab:common:v1#/$defs/TASK"},
        "review_request_id": {"$ref": "urn:collab:common:v1#/$defs/RR"},
        "review_id": {"$ref": "urn:collab:common:v1#/$defs/REV"},
        "review_type": {"enum": ["PLAN_REVIEW", "FINAL_REVIEW"]},
        "review_round": {"type": "integer", "minimum": 1},
        "content_revision": {"type": "integer", "minimum": 1},
        "expected_task_version": {"type": "integer", "minimum": 0},
        "decision_policy_version": {"const": "grokbuddy-v1-dual-round"},
        "blocker_category": {"enum": ["DIRECTION", "CORE_REQUIREMENT", "SECURITY", "DATA"]},
        "review_profile": {"$ref": "urn:collab:common:v1#/$defs/profile"},
        "review_profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "profile_sha256": {"$ref": "urn:collab:common:v1#/$defs/hash"},
        "input_sha256": {"$ref": "urn:collab:common:v1#/$defs/hash"},
        "verdict": {"enum": ["PASS", "NEEDS_CHANGES", "BLOCK"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "reviewer": {
          "type": "object",
          "properties": {
            "type": {"enum": ["mock", "grok_bot", "gpt", "claude", "gemini", "local"]},
            "id": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "required": ["type", "id"],
          "additionalProperties": false
        },
        "timestamp": {"$ref": "urn:collab:common:v1#/$defs/timestamp"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "urn:collab:common:v1#/$defs/evidence"}
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {"type": "string", "minLength": 1, "maxLength": 100},
              "description": {"type": "string", "minLength": 1, "maxLength": 4000},
              "blocking": {"type": "boolean"},
              "mitigation": {"type": "string", "minLength": 1, "maxLength": 4000}
            },
            "required": ["code", "description", "blocking", "mitigation"],
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "proposed_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {"type": "string", "minLength": 1, "maxLength": 4000},
              "scope": {"$ref": "#/$defs/v2Scope"},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
            },
            "required": ["description", "scope", "rationale"],
            "additionalProperties": false
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/v2Finding"}},
        "verifications": {"type": "array", "items": {"$ref": "#/$defs/v2Verification"}}
      },
      "required": [
        "protocol_version", "task_id", "review_request_id", "review_id", "review_type",
        "review_round", "content_revision", "expected_task_version", "review_profile",
        "review_profile_version", "profile_sha256", "input_sha256", "verdict", "summary",
        "reviewer", "timestamp", "evidence", "risks", "recommendations",
        "proposed_changes", "findings", "verifications"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "NEEDS_CHANGES"}}, "required": ["verdict"]},
          "then": {"properties": {"findings": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {
              "decision_policy_version": {"const": "grokbuddy-v1-dual-round"},
              "review_round": {"const": 1},
              "verdict": {"const": "BLOCK"}
            },
            "required": ["decision_policy_version", "review_round", "verdict"]
          },
          "then": {"properties": {"findings": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {
              "decision_policy_version": {"const": "grokbuddy-v1-dual-round"},
              "review_round": {"const": 2}
            },
            "required": ["decision_policy_version", "review_round"]
          },
          "then": {
            "properties": {"verdict": {"enum": ["PASS", "BLOCK"]}},
            "allOf": [{
              "if": {"properties": {"verdict": {"const": "BLOCK"}}, "required": ["verdict"]},
              "then": {"required": ["blocker_category"],
                       "properties": {"evidence": {"minItems": 1}}}
            }]
          }
        }
      ]
    }
  }
}
